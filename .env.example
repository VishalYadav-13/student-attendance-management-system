# SAMS - Student Attendance Management System Environment Configuration
# Copy this file to .env and configure your secrets

APP_NAME="Student Attendance Management System"
APP_SHORT_NAME="SAMS"
# In production: Set APP_ENV=production and APP_DEBUG=false
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000

# Database Configuration (PostgreSQL primary)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sams_db
DB_USER=postgres
DB_PASSWORD=postgres
# Optional full connection URL (e.g. Supabase, Neon, Railway)
# DATABASE_URL=postgresql://postgres:password@ep-sample-123.us-east-2.aws.neon.tech/sams_db?sslmode=require

# Google Gemini API (Server-Side Only - NEVER expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Security & Sessions
SESSION_SECRET=super_secret_random_64_character_string_for_session_encryption
JWT_SECRET=super_secret_random_64_character_jwt_signing_key_change_in_production
TOKEN_EXPIRY_HOURS=24
SESSION_LIFETIME_MINUTES=120

# CORS Configuration (Comma-separated allowed origins)
# In production, set to your Vercel frontend URL, e.g.: https://sams-frontend.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,https://studentattendance-management-system.vercel.app,https://student-attendance-management-system.vercel.app,https://sams-frontend.vercel.app

# Attendance Policy Defaults
ATTENDANCE_THRESHOLD_PERCENT=75.0
LATE_GRACE_MINUTES=15
LATE_ATTENDANCE_WEIGHT=1.0

# Biometric & Privacy Configuration
FACE_VERIFICATION_ENABLED=true
LIVENESS_CHECK_REQUIRED=true
CONFIDENCE_THRESHOLD=0.75
STORE_CAMERA_FRAMES=false
CONSENT_REQUIRED=true
DATA_RETENTION_DAYS=365

# Exadel CompreFace Facial Recognition Service (Server-Side Only - NEVER expose to browser)
COMPREFACE_URL=http://localhost:8000
COMPREFACE_API_KEY=your_compreface_recognition_api_key_here
FACE_SIMILARITY_THRESHOLD=0.80

